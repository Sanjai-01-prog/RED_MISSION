# RED MISSION — Environment Configuration Example
# Copy this file to .env and customize your secrets and service credentials.

# Application Environment ('development' | 'production')
NODE_ENV=development
PORT=5000

# Security Secrets (Must be at least 32 characters in production)
JWT_SECRET=replace_this_with_a_long_cryptographically_secure_random_string_for_jwt
SESSION_SECRET=replace_this_with_a_long_cryptographically_secure_random_string_for_sessions

# Database File Path
DB_PATH=server/data/red_mission.db

# Initial Super Admin Provisioning (Used strictly on first boot if no Super Admin exists)
INIT_SUPER_ADMIN_NAME=Super Administrator
INIT_SUPER_ADMIN_USERNAME=superadmin
INIT_SUPER_ADMIN_EMAIL=superadmin@redmission.org
INIT_SUPER_ADMIN_MOBILE=+919999900001
INIT_SUPER_ADMIN_PASSWORD=REDMISSIONSAP@2026

# OTP Verification Feature Flag
# Set OTP_ENABLED=false (default) to run without requiring SMS/Email OTP credentials.
# Set OTP_ENABLED=true when Fast2SMS credentials are fully configured.
OTP_ENABLED=false

# SMS Delivery Provider ('FAST2SMS' | 'DEMO' | 'DISABLED')
# Set SMS_PROVIDER=FAST2SMS for real Indian mobile OTP delivery.
# Set SMS_PROVIDER=DEMO for local offline development.
# Set SMS_PROVIDER=DISABLED when OTP_ENABLED=false.
SMS_PROVIDER=DEMO
FAST2SMS_API_KEY=
FAST2SMS_OTP_ID=
FAST2SMS_CUSTOM_OTP=false

# Email Delivery Provider ('DEMO' | 'SMTP' | 'SENDGRID')
EMAIL_PROVIDER=DEMO

# Optional Twilio Credentials (Production SMS Alternative)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_PHONE_NUMBER=+1234567890

# Optional SMTP Credentials (Production Email)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SMTP_FROM=notifications@redmission.org

# Persistent Website Launch Timer Configuration
# Set ONE fixed official launch timestamp (ISO 8601 with explicit Z or offset) at actual production go-live.
# Keep VITE_PRODUCTION_LAUNCH_ENABLED=false during development & local preview.
# OFFICIAL_LAUNCH_TIMESTAMP=2026-11-12T10:30:00Z
# VITE_OFFICIAL_LAUNCH_TIMESTAMP=2026-11-12T10:30:00Z
VITE_PRODUCTION_LAUNCH_ENABLED=false

# ==============================================================================
# RED MISSION AI Assistant Provider Configuration (Backend Only - NEVER expose in React)
# ==============================================================================
# Supported values: NONE | GEMINI | OPENAI | GROQ | OPENROUTER
AI_PROVIDER=NONE
# Set the API key for your chosen provider (or use provider-specific key below)
AI_API_KEY=
# Recommended default models:
# - GEMINI: gemini-2.5-flash
# - OPENAI: gpt-4o-mini
# - GROQ: llama-3.3-70b-versatile
# - OPENROUTER: openai/gpt-4o-mini
AI_MODEL=
# Optional provider-specific keys (used if AI_API_KEY is left empty)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional custom OpenAI-compatible endpoint URL
# AI_BASE_URL=
AI_MAX_TOKENS=900
AI_TEMPERATURE=0.4
AI_TIMEOUT_MS=25000
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=20
